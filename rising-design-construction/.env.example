DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local quick-start defaults to SQLite; use PostgreSQL when available:
 DATABASE_URL=postgresql://user:password@localhost:5432/rising_design

# Local uploads use disk unless USE_R2=True.
USE_R2=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=rising-public-media
R2_PRIVATE_BUCKET=rising-private-inquiries
R2_PUBLIC_CUSTOM_DOMAIN=media.example.com

# For local development, mail is printed in the terminal. Use demo@example.com for a placeholder.
INQUIRY_NOTIFY_EMAIL=demo@example.com
DEFAULT_FROM_EMAIL="Rising Design and Construction <website@example.com>"
RESEND_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
